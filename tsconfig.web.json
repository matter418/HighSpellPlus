{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/renderer/**/*.ts", "src/preload/*.d.ts", "src/types/*.d.ts", "src/preload/settings.ts", "src/shared/**/*"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@static/*": ["static/*"]
    },
    "composite": true
  }
}